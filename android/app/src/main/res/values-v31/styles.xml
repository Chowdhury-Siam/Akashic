<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/yutaka_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/yutaka_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/yutaka_launch_background</item>
        <item name="android:navigationBarColor">@color/yutaka_launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/yutaka_launch_background</item>
    </style>
</resources>
